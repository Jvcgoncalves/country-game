# Server-only REST Countries credential. Never prefix this with VITE_.
REST_COUNTRIES_API_KEY=replace-with-server-key

# Durable server-only cache for Vercel. Local development can omit both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local Fastify port. Vercel supplies its own runtime port.
API_PORT=3001
